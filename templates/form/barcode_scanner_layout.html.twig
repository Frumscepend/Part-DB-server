{% block barcode_scanner_widget -%}
    {% import 'components/barcode_scanner.macro.html.twig' as scanner %}
    <div class="position-relative" data-autocomplete-panel-container
            {{ stimulus_controller('elements/barcode_input_scanner') }}>
        <div class="input-group">
            {%- set attr = attr|merge({'data-elements--barcode-input-scanner-target': 'input'}) -%}
            {{- block('form_widget_simple') -}}
            {{- scanner.button(id, disabled) -}}
        </div>
        {{- scanner.modal(id) -}}
    </div>
{%- endblock barcode_scanner_widget %}

{% block storage_location_scanner_widget -%}
    {% import 'components/barcode_scanner.macro.html.twig' as scanner %}
    <div {{ stimulus_controller('elements/barcode_input_scanner', {
        resolveUrl: path('scan_storage_location_lookup'),
    }) }}>
        <div class="input-group">
            <div class="flex-grow-1">
                {%- set attr = attr|merge({'data-elements--barcode-input-scanner-target': 'input'}) -%}
                {{- block('choice_widget_collapsed') -}}
            </div>
            {{- scanner.button(id, disabled) -}}
        </div>
        <div class="input-group input-group-sm mt-2 d-none"
                {{ stimulus_target('elements/barcode_input_scanner', 'scannedBarcodeContainer') }}>
            <span class="input-group-text"><i class="fa-solid fa-barcode fa-fw" aria-hidden="true"></i></span>
            <input type="text" class="form-control" readonly
                   aria-label="{% trans %}storelocation.user_barcode.label{% endtrans %}"
                    {{ stimulus_target('elements/barcode_input_scanner', 'scannedBarcode') }}>
            <button type="button" class="btn btn-outline-secondary"
                    title="{% trans %}barcode_input_scanner.remove_barcode{% endtrans %}"
                    aria-label="{% trans %}barcode_input_scanner.remove_barcode{% endtrans %}"
                    {{ stimulus_action('elements/barcode_input_scanner', 'clearScannedBarcode') }}>
                <i class="fa-solid fa-xmark fa-fw" aria-hidden="true"></i>
            </button>
        </div>
        {{- scanner.modal(id) -}}
    </div>
{%- endblock storage_location_scanner_widget %}
