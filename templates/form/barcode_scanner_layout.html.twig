{% block barcode_scanner_widget -%}
    {% import 'components/barcode_scanner.macro.html.twig' as scanner %}
    <div class="position-relative" data-autocomplete-panel-container
            {{ stimulus_controller('elements/barcode_input_scanner') }}>
        <div class="input-group">
            {%- set attr = attr|merge({'data-elements--barcode-input-scanner-target': 'input'}) -%}
            {{- block('form_widget_simple') -}}
            {{- scanner.button(id, disabled) -}}
        </div>
        {{- scanner.modal(id) -}}
    </div>
{%- endblock barcode_scanner_widget %}

{% block storage_location_scanner_widget -%}
    {% import 'components/barcode_scanner.macro.html.twig' as scanner %}
    <div {{ stimulus_controller('elements/barcode_input_scanner', {
        resolveUrl: path('scan_storage_location_lookup'),
    }) }}>
        <div class="input-group">
            <div class="flex-grow-1">
                {%- set attr = attr|merge({'data-elements--barcode-input-scanner-target': 'input'}) -%}
                {{- block('choice_widget_collapsed') -}}
            </div>
            {{- scanner.button(id, disabled) -}}
        </div>
        {{- scanner.modal(id) -}}
    </div>
{%- endblock storage_location_scanner_widget %}
